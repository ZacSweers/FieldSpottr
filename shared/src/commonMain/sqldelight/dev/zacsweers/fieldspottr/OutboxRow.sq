-- One table for every outbox in the database, split by name.
CREATE TABLE IF NOT EXISTS outboxRow (
  -- The order rows send in
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  -- The EntryId: a Uuid, so no other install or device ever reuses it
  id TEXT NOT NULL UNIQUE,
  -- Which Outbox owns the row
  outbox TEXT NOT NULL,
  orderingKey TEXT NOT NULL,
  -- PayloadCodec output
  payload TEXT NOT NULL,
  -- queued, sending, failed, sent or discarded
  status TEXT NOT NULL,
  -- Failed rows only
  cause TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  lastError TEXT,
  -- 1 once the row's optimistic change was undone, or an undo was attempted
  reverted INTEGER NOT NULL DEFAULT 0,
  -- Epoch millis when the current backoff ends, or null when not backing off
  retryAt INTEGER,
  -- Epoch millis once the row is done (sent and committed, or discarded), pruned after
  -- keepSettledFor
  settledAt INTEGER,
  -- 1 once the outbox's handle took the sent row into its local state
  committed INTEGER NOT NULL DEFAULT 0,
  -- Epoch millis when the send finished
  sentAt INTEGER,
  -- The server's answer in the reply codec's format, kept until the row is committed. The write
  -- that marks the row committed clears it. Null when the server answered with nothing.
  reply TEXT
);

-- Rows not done, in send order, for pending and owed
CREATE INDEX IF NOT EXISTS outboxRow_pending ON outboxRow(outbox, settledAt, seq);

-- Finds one key's rows by status in send order, for heads and nextSendable
CREATE INDEX IF NOT EXISTS outboxRow_key ON outboxRow(outbox, orderingKey, status, seq);

insert:
INSERT INTO outboxRow(id, outbox, orderingKey, payload, status) VALUES (?, ?, ?, ?, 'queued');

pending:
SELECT * FROM outboxRow WHERE outbox = ? AND settledAt IS NULL ORDER BY seq;

-- Rows that wait for the outbox's handle: sent and not committed, or failed and not reverted
owed:
SELECT * FROM outboxRow
WHERE outbox = ? AND settledAt IS NULL
  AND ((status = 'sent' AND committed = 0) OR (status = 'failed' AND reverted = 0))
ORDER BY seq;

-- One key's owed rows, through outboxRow_key: one index search for each of the two statuses
owedOnKey:
SELECT * FROM outboxRow
WHERE outbox = :outbox AND orderingKey = :key AND status IN ('sent', 'failed')
  AND settledAt IS NULL
  AND ((status = 'sent' AND committed = 0) OR (status = 'failed' AND reverted = 0))
ORDER BY seq;

byId:
SELECT * FROM outboxRow WHERE outbox = ? AND id = ?;

-- Each key's oldest queued or sending row. It reads only outboxRow_key, one entry per row of the
-- outbox, and fetches one row per key.
heads:
SELECT * FROM outboxRow
WHERE seq IN (
  SELECT MIN(seq) FROM outboxRow
  WHERE outbox = :outbox AND status IN ('queued', 'sending')
  GROUP BY orderingKey
)
ORDER BY seq;

-- A key's oldest queued or sending row after seq :after, to step past one that does not decode.
-- Each status is one index search for one seq, so no rows are sorted.
nextSendable:
SELECT * FROM outboxRow
WHERE seq IN (
  (
    SELECT seq FROM outboxRow
    WHERE outbox = :outbox AND orderingKey = :key AND status = 'queued' AND seq > :after
    ORDER BY seq
    LIMIT 1
  ),
  (
    SELECT seq FROM outboxRow
    WHERE outbox = :outbox AND orderingKey = :key AND status = 'sending' AND seq > :after
    ORDER BY seq
    LIMIT 1
  )
)
ORDER BY seq
LIMIT 1;

-- Matches the stored status and cause exactly as read, so a write between the read and this
-- update makes it change nothing
compareAndSet:
UPDATE outboxRow
SET
  status = :status,
  cause = :cause,
  attempts = :attempts,
  lastError = :lastError,
  reverted = :reverted,
  retryAt = :retryAt,
  settledAt = :settledAt,
  committed = :committed,
  sentAt = :sentAt,
  reply = :reply
WHERE outbox = :outbox AND id = :id AND status = :expectedStatus AND cause IS :expectedCause;

changes:
SELECT changes();

-- NULL never compares, so pending rows stay
pruneSettled:
DELETE FROM outboxRow WHERE outbox = ? AND settledAt < ?;

-- Every outbox at once, for a logout
deleteAll:
DELETE FROM outboxRow;

-- One record per row each write ends or deletes, so a store names those rows without reading them.
-- A write adds its records in its own transaction, so they show once it commits.
CREATE TABLE IF NOT EXISTS outboxChange (
  -- Grows with every record and is never reused. One writer commits at a time, so records become
  -- visible in seq order.
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  -- The changed row's outbox, or null for a write that changed every outbox
  outbox TEXT,
  -- The changed row, or null for a write that changed every row
  id TEXT
);

recordChange:
INSERT INTO outboxChange(outbox, id) VALUES (?, ?);

-- The rows pruneSettled deletes with the same arguments, recorded before it runs
recordPruned:
INSERT INTO outboxChange(outbox, id)
SELECT outbox, id FROM outboxRow WHERE outbox = ? AND settledAt < ?;

-- For deleteAll, which changes every outbox
recordAllChanged:
INSERT INTO outboxChange(outbox, id) VALUES (NULL, NULL);

lastChange:
SELECT MAX(seq) AS last FROM outboxChange;

-- Every record after :after, for every outbox. Each record's seq is the last one's plus one, so a
-- first seq past :after + 1 shows that records were pruned before this read.
changesSince:
SELECT seq, outbox, id FROM outboxChange WHERE seq > ? ORDER BY seq;

-- Keeps the newest records. A reader that falls further behind reads every row it follows instead.
pruneChanges:
DELETE FROM outboxChange WHERE seq <= (SELECT MAX(seq) FROM outboxChange) - 1000;
